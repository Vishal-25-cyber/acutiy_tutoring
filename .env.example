# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/acuity_tutoring

# JWT Secret for Session Signing
JWT_SECRET=super_secret_jwt_acuity_tutoring_production_key_2025_min32chars

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LiveKit Realtime Video/Audio Credentials (Optional for local simulated dev, required for cloud)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_key_at_least_32_characters_long_12345
NEXT_PUBLIC_LIVEKIT_URL=wss://acuity-tutoring-demo.livekit.cloud

# Storage Provider (AWS S3 / Cloudinary / Cloudflare R2 / Local)
STORAGE_PROVIDER=local
